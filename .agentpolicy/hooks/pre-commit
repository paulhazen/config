#!/bin/sh
#
# Agent policy: refuse commits that modify centrally managed policy
# infrastructure unless policy mutation is authorized.
#
# What this hook refuses is a hand edit, not a commit. Policy files have to
# reach Git: an installation is committed, and the lock file is committed so
# the applied policy revision is visible in history. Refusing every staged
# policy path made both impossible, and a project could not complete its own
# installation.
#
# So the test is content, not path. Synchronization records the Git blob id of
# every file it installs, and a staged policy file matching its record is the
# synchronization result being committed. Anything else is an edit that did not
# come through synchronization, and is refused as before.
#
# Authorization is read from the policy configuration file. Only "always"
# grants standing authorization; "token" authorizes an individual user
# request, which a commit hook cannot observe, and so is treated here as
# unauthorized.
#
# This hook is agent-agnostic and applies equally to human users. Bypassing
# with --no-verify is possible; the hook defends against mistakes, not against
# a determined process.
#
# Every path and list this hook needs is generated into policy.env beside it
# during synchronization. The hook deliberately carries no built-in fallback:
# enforcing a stale copy of the protected-file list would be worse than
# refusing, because it would appear to work while silently protecting less
# than the policy requires.

set -eu

hooks_dir=$(dirname "$0")
env_file="$hooks_dir/policy.env"

if [ ! -f "$env_file" ]; then
    echo "agent-policy: generated configuration is missing." >&2
    echo "agent-policy: expected $env_file" >&2
    echo "" >&2
    echo "Run the policy synchronization script to regenerate it, then commit" >&2
    echo "again. Refusing the commit rather than enforcing an outdated policy." >&2
    exit 1
fi

# shellcheck source=/dev/null
. "$env_file"

: "${POLICY_FILES:=}"
: "${POLICY_FILE_EXEMPTIONS:=}"
: "${CONFIG_PATH:=}"
: "${SYNC_COMMAND:=the policy synchronization script}"
: "${SYNC_DIGEST_NAME:=agentpolicy-sync.index}"

# CONFIG_PATH was added to policy.env after this hook was. A policy.env
# generated by an older engine does not declare it, and without a value this
# hook would read no configuration and treat mutation as unauthorized -- which
# is safe but wrong for a project configured as "always". Fall back to the
# locations the configuration has occupied, newest layout first.
if [ -z "$CONFIG_PATH" ]; then
    for candidate in .agentpolicy/config.json .agent-policy.json; do
        if [ -f "$candidate" ]; then
            CONFIG_PATH="$candidate"
            break
        fi
    done
fi

mutation_mode="never"

if [ -n "$CONFIG_PATH" ] && [ -f "$CONFIG_PATH" ]; then
    parsed=$(
        tr -d ' \t\n' < "$CONFIG_PATH" |
        sed -n 's/.*"policyMutationMode":"\([^"]*\)".*/\1/p'
    )

    if [ -n "$parsed" ]; then
        mutation_mode="$parsed"
    fi
fi

if [ "$mutation_mode" = "always" ]; then
    exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMRD)

if [ -z "$staged" ]; then
    exit 0
fi

# A path may be inside a protected directory yet still be project owned by
# content, such as the seeded testing document. The specification names those
# explicitly and they are checked first.
is_exempt() {
    candidate="$1"

    for exempt in $POLICY_FILE_EXEMPTIONS; do
        case "$exempt" in
            */)
                case "$candidate" in
                    "$exempt"*) return 0 ;;
                esac
                ;;
            *)
                if [ "$candidate" = "$exempt" ]; then
                    return 0
                fi
                ;;
        esac
    done

    return 1
}

# The record of what the last synchronization installed. It lives in the Git
# directory rather than the working tree, because it describes one clone's last
# run and is not itself a file anyone commits.
digest_file=""

git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null || true)

if [ -n "$git_dir" ]; then
    digest_file="$git_dir/$SYNC_DIGEST_NAME"
fi

is_protected() {
    candidate="$1"

    for policy_path in $POLICY_FILES; do
        case "$policy_path" in
            */)
                # Directory entry: match anything beneath it.
                case "$candidate" in
                    "$policy_path"*) return 0 ;;
                esac
                ;;
            *)
                if [ "$candidate" = "$policy_path" ]; then
                    return 0
                fi
                ;;
        esac
    done

    return 1
}

# True when the staged content of a path is byte for byte what synchronization
# installed. Both sides are Git blob ids, so the comparison survives whatever
# line-ending conversion a project has configured; comparing raw file bytes
# against the index would fail on every Windows clone.
is_as_synchronized() {
    candidate="$1"

    [ -n "$digest_file" ] && [ -f "$digest_file" ] || return 1

    recorded=""

    while read -r id path; do
        case "$id" in
            ''|'#'*) continue ;;
        esac

        if [ "$path" = "$candidate" ]; then
            recorded="$id"
            break
        fi
    done < "$digest_file"

    [ -n "$recorded" ] || return 1

    # A staged deletion has no blob, so it never matches and stays refused.
    staged_blob=$(git rev-parse --quiet --verify ":$candidate" 2>/dev/null || true)

    [ -n "$staged_blob" ] && [ "$staged_blob" = "$recorded" ]
}

offending=""
unrecorded=""

for file in $staged; do

    if is_exempt "$file"; then
        continue
    fi

    if ! is_protected "$file"; then
        continue
    fi

    if is_as_synchronized "$file"; then
        continue
    fi

    offending="$offending  $file
"
done

if [ -n "$offending" ] && { [ -z "$digest_file" ] || [ ! -f "$digest_file" ]; }; then
    unrecorded="yes"
fi

if [ -n "$offending" ]; then
    echo "agent-policy: refusing to commit changes to managed policy files." >&2
    echo "" >&2
    printf '%s' "$offending" >&2

    if [ -n "$unrecorded" ]; then
        cat >&2 <<EOF

No record of an installed policy exists in this clone, so the staged content
cannot be confirmed as what synchronization produced. Run:

    $SYNC_COMMAND

then commit again. Refusing rather than accepting content this clone cannot
account for.

EOF
        exit 1
    fi

    cat >&2 <<EOF

The staged content of these files is not what synchronization installed.

Current policyMutationMode: $mutation_mode

Policy changes belong in the central policy repository and reach this project
through:

    $SYNC_COMMAND

Committing a synchronization result is permitted, and needs no configuration
change. Discard the local edits and synchronize, or, if this project is
intended to author policy, set policyMutationMode to "always" in the policy
configuration file. An agent must not make that change on its own initiative.

EOF
    exit 1
fi

exit 0
